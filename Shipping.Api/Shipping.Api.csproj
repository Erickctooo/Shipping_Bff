  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shipping.Infrastructure\Shipping.Infrastructure.csproj" />
    <ProjectReference Include="..\ShippingSystem.Domain\Shipping.Domain.csproj" />
  </ItemGroup>

</Project>
